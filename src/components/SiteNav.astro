---
const navLinks = [
  { href: '/#apps', label: 'Apps' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<!-- N5 · Floating pill (atmospheric default). Prev build: N1b mega-menu. -->
<header id="site-nav" class="fixed top-3 sm:top-4 inset-x-0 z-[var(--z-nav)] px-4">
  <nav class="mx-auto max-w-3xl glass rounded-full shadow-2xl shadow-black/40">
    <div class="flex h-14 items-center justify-between pl-4 pr-2 sm:pl-5 sm:pr-2.5">
      <a href="/" class="flex items-center gap-2 shrink-0 no-underline">
        <img src="/images/logo.svg" alt="Tidox" width="28" height="28" class="h-7 w-7" />
        <span class="text-lg font-bold font-[family-name:var(--font-display)]">Tidox</span>
      </a>

      <div class="hidden md:flex items-center gap-0.5">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-2 text-sm font-medium rounded-full transition-colors text-text-secondary hover:text-text-primary hover:bg-white/5 no-underline"
          >
            {link.label}
          </a>
        ))}
      </div>

      <a
        href="/player/"
        class="ml-2 px-4 py-2 text-sm font-semibold rounded-full bg-accent-violet text-white whitespace-nowrap transition-transform hover:scale-[1.03] no-underline"
      >
        Get Apps
      </a>
    </div>
  </nav>
</header>
