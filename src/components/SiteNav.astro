---
import {
  PRODUCT_CATEGORIES,
  productsByCategory,
} from '../data/products';

const navLinks = [
  { href: '/pricing/', label: 'Pricing' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header id="site-nav" class="fixed top-0 inset-x-0 z-[var(--z-nav)]">
  <nav class="glass-nav">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2 shrink-0 no-underline">
          <img src="/images/logo.svg" alt="Tidox" width="32" height="32" class="h-8 w-8" />
          <span class="text-xl font-bold font-[family-name:var(--font-display)] text-gradient">Tidox</span>
        </a>

        <div class="hidden lg:flex items-center gap-1">
          <div class="relative group">
            <button
              type="button"
              class="flex items-center gap-1 px-4 py-2 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors rounded-lg hover:bg-white/5"
            >
              Products
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
              <div class="glass rounded-2xl border border-border-subtle p-6 w-[42rem] shadow-2xl shadow-black/40">
                <div class="grid grid-cols-2 gap-6">
                  {PRODUCT_CATEGORIES.map((category) => (
                    <div>
                      <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-3 px-2">
                        {category}
                      </h3>
                      <div class="space-y-0.5">
                        {productsByCategory(category).slice(0, 6).map((product) => (
                          <a
                            href={`/${product.slug}/`}
                            class="flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors text-text-secondary hover:text-text-primary hover:bg-white/5 no-underline"
                          >
                            <img
                              src={product.icon}
                              alt=""
                              width="32"
                              height="32"
                              loading="lazy"
                              class="w-8 h-8 rounded-lg shrink-0"
                            />
                            <span>
                              <span class="block font-medium text-text-primary">{product.name}</span>
                              <span class="block text-xs text-text-muted truncate max-w-[14rem]">{product.tagline}</span>
                            </span>
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
                <div class="mt-5 pt-4 border-t border-border-subtle">
                  <a href="/#products" class="text-sm font-medium text-accent-violet hover:text-accent-cyan transition-colors no-underline">
                    View all apps →
                  </a>
                </div>
              </div>
            </div>
          </div>

          {navLinks.map((link) => (
            <a
              href={link.href}
              class="px-4 py-2 text-sm font-medium rounded-lg transition-colors text-text-secondary hover:text-text-primary hover:bg-white/5 no-underline"
            >
              {link.label}
            </a>
          ))}

          <a
            href="/#products"
            class="ml-3 px-5 py-2 text-sm font-semibold rounded-[var(--radius-button)] bg-gradient-to-r from-accent-violet to-accent-cyan text-white transition-all hover:opacity-90 no-underline"
          >
            Get Apps
          </a>
        </div>

        <a
          href="/#products"
          class="lg:hidden px-4 py-2 text-sm font-semibold rounded-[var(--radius-button)] bg-gradient-to-r from-accent-violet to-accent-cyan text-white no-underline"
        >
          Apps
        </a>
      </div>
    </div>
  </nav>
</header>
