---
import { products } from '../data/products';

const footerLinks = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Service' },
];
---

<footer class="border-t border-border-subtle bg-surface-raised/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <a href="/" class="flex items-center gap-2 no-underline">
          <img src="/images/logo.svg" alt="Tidox" width="32" height="32" class="h-8 w-8" />
          <span class="text-lg font-bold font-[family-name:var(--font-display)] text-gradient">Tidox</span>
        </a>
        <p class="text-sm text-text-secondary mt-4 leading-relaxed">
          Privacy-first Android apps. No accounts, no tracking, no compromises.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-4">Company</h3>
        <ul class="space-y-2.5">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted mb-4">Popular Apps</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2">
          {products.slice(0, 9).map((product) => (
            <a
              href={`/${product.slug}/`}
              class="text-sm text-text-secondary hover:text-text-primary transition-colors no-underline"
            >
              {product.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="border-t border-border-subtle py-6 mt-12 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-muted">© {new Date().getFullYear()} Tidox. All rights reserved.</p>
    </div>
  </div>
</footer>
