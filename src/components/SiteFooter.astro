---
const links = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
];
const year = new Date().getFullYear();
---

<!-- Ft5 · Statement (atmospheric default). Prev build: Ft3 index columns. -->
<footer class="border-t border-border-subtle">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <p class="text-3xl sm:text-4xl md:text-5xl font-bold font-[family-name:var(--font-display)] tracking-tight leading-tight max-w-[20ch]">
      Private apps, <span class="text-gradient">built to stay that way.</span>
    </p>

    <div class="mt-14 pt-8 border-t border-border-subtle flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="flex items-center gap-2 no-underline shrink-0">
        <img src="/images/logo.svg" alt="Tidox" width="28" height="28" class="h-7 w-7" />
        <span class="text-base font-bold font-[family-name:var(--font-display)]">Tidox</span>
      </a>

      <nav class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map((link) => (
          <a href={link.href} class="text-sm text-text-secondary hover:text-text-primary transition-colors whitespace-nowrap no-underline">
            {link.label}
          </a>
        ))}
      </nav>

      <p class="text-xs text-text-muted whitespace-nowrap">© {year} Tidox</p>
    </div>
  </div>
</footer>
